# ───────────── Sahyog server configuration ─────────────
# Copy to `.env` (project root). Never commit real credentials.

NODE_ENV=development
PORT=5000

# Local MongoDB (docker compose up -d) or a MongoDB Atlas SRV string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sahyog?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sahyog

# Long random string (>= 16 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed by CORS + Socket.IO. Comma-separate several.
CLIENT_URL=http://localhost:5173

# Cookie behaviour. Leave blank for automatic: lax in development, none+secure in production.
# COOKIE_SAMESITE=lax

# Cloudinary (optional in development: images fall back to server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional: password-reset emails; links are logged to the console when blank in development)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Sahyog <no-reply@sahyog.local>"
