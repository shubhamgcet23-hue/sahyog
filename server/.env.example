# ---- Server ----
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/sahyog for local MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sahyog?retryWrites=true&w=majority
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Allowed frontend origin(s), comma separated. Dev: http://localhost:5173
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build image URLs when Cloudinary is not configured)
SERVER_URL=http://localhost:5000
# Cookie SameSite: lax (same-site / Vercel rewrite proxy) or none (direct cross-site, requires HTTPS). Default: lax in dev, none in production
COOKIE_SAMESITE=lax

# ---- Cloudinary (optional in dev: without it uploads are stored in server/uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email via Nodemailer (optional: without it emails are printed to the server log) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
